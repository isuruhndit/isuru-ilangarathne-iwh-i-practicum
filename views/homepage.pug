doctype html
html
  head
    title Homepage | Integrating With HubSpot I Practicum
  body
    h1 Contacts Table

    a(href="/update-cobj") Add to this table

    if contacts.length
      table(border="1" cellpadding="5" cellspacing="0")
        thead
          tr
            th First Name
            th Last Name
            th Email
        tbody
          each contact in contacts
            tr
              td= contact.properties.firstname || '-'
              td= contact.properties.lastname || '-'
              td= contact.properties.email || '-'
    else
      p No contacts found.